<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Spoke.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Spoke Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the window draws its own; this is the drag area) -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7C9;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="1" Text="Spoke Settings" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Wheels" Tag="wheel">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="General" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock x:Name="DaemonState" Margin="16,0,16,16" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Opacity="0.8" />
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Padding="32,8,32,0" Spacing="8">
                    <InfoBar x:Name="DaemonBar" Severity="Warning" IsClosable="False"
                             Title="Spoke isn't running"
                             Message="Changes are saved and apply when Spoke starts.">
                        <InfoBar.ActionButton>
                            <Button Content="Start Spoke" Click="OnStartSpoke" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="FileBar" Severity="Error" IsClosable="False" Title="settings.json has a problem">
                        <InfoBar.ActionButton>
                            <Button Content="Open settings.json" Click="OnOpenFile" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <ContentControl x:Name="PageHost" Grid.Row="1"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <TextBlock x:Name="SaveState" Grid.Row="2" Margin="32,6,32,10"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
