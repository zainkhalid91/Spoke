<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spoke.Settings.WheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Spoke.Settings">

    <Grid Padding="32,12,32,0" ColumnSpacing="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Wheels" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Click="OnPreview" AutomationProperties.Name="Show wheel" ToolTipService.ToolTip="Opens the real wheel under the mouse pointer">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                    <TextBlock Text="Show wheel" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Left: name, shortcut, slices -->
        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Which wheel; Tab switches between them on screen -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="WheelList" SelectionMode="Single" SelectionChanged="OnWheelSelected"
                          AutomationProperties.Name="Wheels"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <DropDownButton Grid.Column="1" x:Name="WheelMenu" AutomationProperties.Name="Wheel actions" ToolTipService.ToolTip="New, copy, import, export or delete a wheel"
                                VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="New wheel" Click="OnNewWheel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Duplicate this wheel" Click="OnDuplicateWheel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Import a wheel…" Click="OnImportWheel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export this wheel…" Click="OnExportWheel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="DeleteWheelItem" Text="Delete this wheel" Click="OnDeleteWheel"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <TextBox x:Name="WheelName" Grid.Row="1" Header="Name" PlaceholderText="Spoke" TextChanged="OnWheelNameChanged" />

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="Shortcut" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" AutomationProperties.Name="Change shortcut" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnRecord" PreviewKeyDown="OnRecordKeyDown" LostFocus="OnRecordLostFocus">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE765;" FontSize="14" />
                            <TextBlock x:Name="HotkeyText" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HotkeyDefault" Grid.Column="1" Content="Use default" Click="OnHotkeyDefault"
                            ToolTipService.ToolTip="Let Spoke pick the first free shortcut (Ctrl+Alt+Space if it's free)" />
                </Grid>
                <InfoBar x:Name="HotkeyBar" IsClosable="True">
                    <InfoBar.Content>
                        <StackPanel x:Name="Suggestions" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" />
                    </InfoBar.Content>
                </InfoBar>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button x:Name="GroupBack" AutomationProperties.Name="Back to the wheel" ToolTipService.ToolTip="Back to the wheel's slices"
                        Click="OnGroupBack" Visibility="Collapsed" Padding="8,4">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                </Button>
                <TextBlock x:Name="SliceCount" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <ListView x:Name="SliceList" Grid.Row="4" SelectionMode="Single"
                      CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                      SelectionChanged="OnSliceSelected" DragItemsCompleted="OnSlicesReordered"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SliceRow">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                <DropDownButton x:Name="AddButton" AutomationProperties.Name="Add slice" ToolTipService.ToolTip="Add a slice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuFlyoutItem Text="App" Tag="app" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Website" Tag="url" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Folder" Tag="folder" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Web search" Tag="search" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Text snippet" Tag="text" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem Text="Tool" Tag="tool" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddGroupItem" Text="Group (more choices, or run several)" Tag="group" Click="OnAdd"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="RemoveButton" AutomationProperties.Name="Remove slice" Click="OnRemove" ToolTipService.ToolTip="Remove the selected slice">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button x:Name="UpButton" AutomationProperties.Name="Move up" Click="OnMoveUp" ToolTipService.ToolTip="Move up (earlier on the wheel)">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button x:Name="DownButton" AutomationProperties.Name="Move down" Click="OnMoveDown" ToolTipService.ToolTip="Move down">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Right: inspector -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Inspector" Spacing="14" Padding="20" Margin="0,0,0,12" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Name="InspectorTitle" Style="{StaticResource SubtitleTextBlockStyle}" />

                <ComboBox x:Name="TypeBox" Header="Type" MinWidth="220" SelectionChanged="OnTypeChanged">
                    <ComboBoxItem Content="App" Tag="app" />
                    <ComboBoxItem Content="Website" Tag="url" />
                    <ComboBoxItem Content="Folder" Tag="folder" />
                    <ComboBoxItem Content="Web search" Tag="search" />
                    <ComboBoxItem Content="Text snippet" Tag="text" />
                    <ComboBoxItem Content="Tool" Tag="tool" />
                    <ComboBoxItem x:Name="TypeGroupItem" Content="Group" Tag="group" />
                </ComboBox>

                <!-- tool -->
                <ComboBox x:Name="ToolBox" Header="Tool" MinWidth="220" SelectionChanged="OnToolChanged">
                    <ComboBoxItem Content="Screenshot" Tag="screenshot" />
                    <ComboBoxItem Content="Colour picker" Tag="colorPicker" />
                    <ComboBoxItem Content="Clips (copied images)" Tag="clips" />
                    <ComboBoxItem Content="Files (convert, resize, PDF)" Tag="files" />
                    <ComboBoxItem Content="Text tools" Tag="text" />
                    <ComboBoxItem Content="Generate (UUID, password, date)" Tag="generate" />
                    <ComboBoxItem Content="System (volume, media, dark mode)" Tag="system" />
                </ComboBox>

                <!-- app / url / folder -->
                <Grid x:Name="TargetRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" TextChanged="OnFieldChanged" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnBrowse" />
                </Grid>
                <TextBox x:Name="ArgsBox" Header="Arguments (optional)" TextChanged="OnFieldChanged" />
                <TextBox x:Name="WorkDirBox" Header="Start in folder (optional)" TextChanged="OnFieldChanged" />
                <TextBox x:Name="BrowserBox" Header="Open in browser (optional)" PlaceholderText="Your default browser, or e.g. firefox.exe" TextChanged="OnFieldChanged" />
                <ComboBox x:Name="OpenBox" Header="When chosen" MinWidth="220" SelectionChanged="OnOpenChanged">
                    <ComboBoxItem Content="Open in File Explorer" Tag="explorer" />
                    <ComboBoxItem Content="Open a terminal here" Tag="terminal" />
                    <ComboBoxItem Content="Copy the path" Tag="copyPath" />
                </ComboBox>

                <!-- search -->
                <ComboBox x:Name="EngineBox" Header="Search with" MinWidth="220" SelectionChanged="OnEngineChanged">
                    <ComboBoxItem Content="Google" Tag="google" />
                    <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                    <ComboBoxItem Content="Bing" Tag="bing" />
                    <ComboBoxItem Content="YouTube" Tag="youtube" />
                    <ComboBoxItem Content="Wikipedia" Tag="wikipedia" />
                    <ComboBoxItem Content="GitHub" Tag="github" />
                    <ComboBoxItem Content="Custom address…" Tag="custom" />
                </ComboBox>
                <TextBox x:Name="EngineUrlBox" Header="Search address" PlaceholderText="https://example.com/search?q={query}" TextChanged="OnFieldChanged" />

                <!-- text -->
                <TextBox x:Name="SnippetBox" Header="Text to type" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" TextChanged="OnFieldChanged" />
                <TextBlock x:Name="TokensHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                           Text="Tokens: {date} {time} {iso} {unix} {uuid} {clipboard}, or a format like {date:dd MMM yyyy}." />

                <!-- group -->
                <StackPanel x:Name="GroupPanel" Spacing="12">
                    <ToggleSwitch x:Name="RunAllSwitch" Header="When chosen" Toggled="OnRunAllToggled"
                                  OffContent="Show its items around the slice" OnContent="Run every item, in order" />
                    <NumberBox x:Name="DelayBox" Header="Pause between items (milliseconds)" Minimum="0" Maximum="10000" SmallChange="100" LargeChange="500"
                               SpinButtonPlacementMode="Compact" ValueChanged="OnDelayChanged" HorizontalAlignment="Left" MinWidth="220" />
                    <Button x:Name="EditGroupButton" Click="OnEditGroup">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock x:Name="EditGroupText" Text="Edit items" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <MenuFlyoutSeparator />
                <TextBox x:Name="LabelBox" Header="Label" TextChanged="OnFieldChanged" />
                <TextBox x:Name="DetailBox" Header="Second line (optional)" TextChanged="OnFieldChanged" />
                <TextBox x:Name="IconBox" Header="Icon (optional)" TextChanged="OnFieldChanged"
                         PlaceholderText="A Segoe Fluent Icons code like E774. Apps use their own icon." />

                <InfoBar x:Name="SliceBar" Severity="Error" IsClosable="False" Title="This slice needs attention" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
