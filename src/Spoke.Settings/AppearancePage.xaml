<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spoke.Settings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,12,32,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Appearance" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Grid.Column="1" Click="OnPreview" AutomationProperties.Name="Show wheel" ToolTipService.ToolTip="Opens the real wheel under the mouse pointer">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock Text="Show wheel" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Theme -->
            <StackPanel Spacing="10" Padding="20" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="Theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="ThemeChoice" MaxColumns="6">
                    <RadioButton Content="Match Windows" Tag="Auto" Checked="OnThemeChanged" />
                    <RadioButton Content="Aurora" Tag="Aurora" Checked="OnThemeChanged" />
                    <RadioButton Content="Ember" Tag="Ember" Checked="OnThemeChanged" />
                    <RadioButton Content="Paper" Tag="Paper" Checked="OnThemeChanged" />
                    <RadioButton Content="Graphite" Tag="Graphite" Checked="OnThemeChanged" />
                    <RadioButton Content="Onyx" Tag="Onyx" Checked="OnThemeChanged" />
                </RadioButtons>
                <StackPanel x:Name="AutoThemes" Orientation="Horizontal" Spacing="16">
                    <ComboBox x:Name="LightBox" Header="In light mode" MinWidth="160" SelectionChanged="OnAutoThemeChanged" />
                    <ComboBox x:Name="DarkBox" Header="In dark mode" MinWidth="160" SelectionChanged="OnAutoThemeChanged" />
                </StackPanel>
            </StackPanel>

            <!-- Colours -->
            <StackPanel Spacing="10" Padding="20" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="Highlight colour" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="The glow, edge and needle when you point at a slice. Icons keep the theme's colours." Opacity="0.8" TextWrapping="Wrap" />
                <RadioButtons x:Name="AccentChoice">
                    <RadioButton Content="Each slice lights up in its own colour" Tag="theme" Checked="OnAccentChanged" />
                    <RadioButton Content="Windows accent colour (follows Windows when you change it)" Tag="windows" Checked="OnAccentChanged" />
                    <RadioButton Content="A colour of my own" Tag="custom" Checked="OnAccentChanged" />
                </RadioButtons>
                <StackPanel x:Name="CustomColorRow" Orientation="Horizontal" Spacing="12">
                    <DropDownButton x:Name="ColorButton" AutomationProperties.Name="Choose colour" ToolTipService.ToolTip="Choose the colour">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border x:Name="Swatch" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="ColorText" FontFamily="Consolas" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                             IsColorSliderVisible="True" IsColorChannelTextInputVisible="True"
                                             IsHexInputVisible="True" ColorChanged="OnColorChanged" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </StackPanel>

            <!-- Size -->
            <StackPanel Spacing="10" Padding="20" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <TextBlock Text="Size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="SizeText" HorizontalAlignment="Right" Opacity="0.8" />
                </Grid>
                <Slider x:Name="SizeSlider" Minimum="70" Maximum="160" StepFrequency="5" TickFrequency="10" TickPlacement="Outside"
                        ValueChanged="OnSizeChanged" />
                <StackPanel x:Name="SizePresets" Orientation="Horizontal" Spacing="8" />
            </StackPanel>

            <!-- Sub-menus -->
            <StackPanel Spacing="10" Padding="20" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <TextBlock Text="More options" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="How Files, Text tools, Generate and System show their options." Opacity="0.8" TextWrapping="Wrap" />
                <RadioButtons x:Name="SubMenuChoice">
                    <RadioButton Content="Extend the wheel: options fan out around the slice" Tag="ring" Checked="OnSubMenusChanged" />
                    <RadioButton Content="Open a new wheel in its place (Esc goes back)" Tag="wheel" Checked="OnSubMenusChanged" />
                </RadioButtons>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
